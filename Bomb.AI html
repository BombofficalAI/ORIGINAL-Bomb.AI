}
const NDOC=DR.length,IDF=new Map();for(const [t,p] of POST)IDF.set(t,Math.log(NDOC/p.length));
const DN=DT.map(ts=>Math.sqrt(ts.reduce((s,t)=>s+IDF.get(t)**2,0)));DT.length=0;
const UNK=Math.log(NDOC);
function lookup(text){
  const qt=toks(text);if(!qt.length)return null;
  let qn=0;const acc=new Map();
  for(const t of qt){const i=IDF.get(t);if(i===undefined){qn+=UNK*UNK;continue}qn+=i*i;for(const id of POST.get(t))acc.set(id,(acc.get(id)||0)+i*i)}
  qn=Math.sqrt(qn);let best=-1,bs=0;
  for(const [id,s] of acc){const sc=s/(qn*DN[id]);if(sc>bs){bs=sc;best=id}}
  return bs>=.5?{r:RESP[DR[best]],s:bs,k:DR[best]}:null;
}
